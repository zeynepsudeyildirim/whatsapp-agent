# Copy to .env for local development. Never commit the real .env.
WA_ENV=dev

# Meta app (developers.facebook.com → your app → App settings → Basic)
WA_APP_SECRET=
# Any random string; enter the same value in the Meta webhook configuration
WA_VERIFY_TOKEN=
# System user access token with whatsapp_business_messaging permission
WA_ACCESS_TOKEN=
WA_GRAPH_API_VERSION=v23.0

WA_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/waagent

# inline (local) | cloud_tasks (staging/production)
WA_QUEUE_BACKEND=inline
WA_WORKER_URL=http://localhost:8080/tasks/process-message
WA_CLOUD_TASKS_QUEUE=
WA_WORKER_AUTH_TOKEN=change-me

# Gemini (Google AI Studio). FREE TIER = synthetic test data only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
